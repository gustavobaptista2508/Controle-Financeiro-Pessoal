[Unit]
Description=GranaOk Web API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=granaok
Group=granaok
WorkingDirectory=/opt/granaok
EnvironmentFile=/opt/granaok/.env
ExecStart=/usr/bin/node /opt/granaok/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/granaok

[Install]
WantedBy=multi-user.target
