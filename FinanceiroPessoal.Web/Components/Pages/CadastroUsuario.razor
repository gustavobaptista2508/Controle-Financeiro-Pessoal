@page "/usuarios/cadastro"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using FinanceiroPessoal.Web.Models
@using FinanceiroPessoal.Core.Data
@inject FinanceiroPessoal.Web.Services.UsuarioCadastroService UsuarioCadastroService
@inject FinanceiroDbContext Db
@inject NavigationManager Navigation
@inject ILogger<CadastroUsuario> Logger
@inject IWebHostEnvironment Environment

<PageTitle>Cadastro</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="auth-shell">
    <MudPaper Elevation="2" Class="auth-card pa-8">
        <MudText Typo="Typo.h4" Class="mb-1">Criar conta</MudText>
        <MudText Typo="Typo.body2" Class="mb-6 auth-subtitle">Comece agora seu controle financeiro premium.</MudText>

        @if (planoSelecionado is not null)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                <strong>@planoSelecionado.Nome</strong> • @($"R$ {planoSelecionado.Preco:N2} / {planoSelecionado.Intervalo}")<br />
                14 dias grátis. Você só assina se quiser continuar.
            </MudAlert>
        }

        @if (!string.IsNullOrWhiteSpace(erro))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@erro</MudAlert>
        }

        @if (!string.IsNullOrWhiteSpace(sucesso))
        {
            <MudAlert Severity="Severity.Success" Dense="true" Class="mb-4">@sucesso</MudAlert>
        }

        <EditForm Model="@cadastroModel" OnSubmit="@HandleSubmitAsync" FormName="cadastroForm">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <InputText class="form-control" @bind-Value="cadastroModel.Nome" placeholder="Nome" />
            <InputText class="form-control mt-2" @bind-Value="cadastroModel.Email" placeholder="E-mail" />
            <InputText class="form-control mt-2" type="password" @bind-Value="cadastroModel.Senha" placeholder="Senha" />
            <InputText class="form-control mt-2" type="password" @bind-Value="cadastroModel.ConfirmarSenha" placeholder="Confirmar senha" />

            <button type="submit" class="btn btn-success mt-5 auth-main-button" disabled="@isSaving">
                @(isSaving ? "Processando..." : "Começar 14 dias grátis")
            </button>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "planoId")] public int? PlanoId { get; set; }

    private readonly CadastroUsuarioModel cadastroModel = new();
    private bool isSaving;
    private string? erro;
    private string? sucesso;
    private FinanceiroPessoal.Core.Models.Plano? planoSelecionado;

    protected override async Task OnInitializedAsync()
    {
        if (!PlanoId.HasValue)
        {
            Navigation.NavigateTo("/planos", true);
            return;
        }

        planoSelecionado = await Db.Planos.FirstOrDefaultAsync(p => p.Id == PlanoId.Value && p.Ativo);
        if (planoSelecionado is null)
        {
            Navigation.NavigateTo("/planos", true);
        }
    }

    private async Task HandleSubmitAsync(EditContext editContext)
    {
        erro = null;
        sucesso = null;

        Logger.LogInformation("Cadastro: submit recebido.");

        var valido = editContext.Validate();

        if (!valido)
        {
            erro = "Verifique os campos informados antes de continuar.";
            Logger.LogWarning("Cadastro: formulário inválido.");
            return;
        }

        await CadastrarAsync();
    }

    private async Task CadastrarAsync()
    {
        if (isSaving)
            return;

        isSaving = true;
        erro = null;
        sucesso = null;

        try
        {
            if (!PlanoId.HasValue || planoSelecionado is null)
            {
                erro = "Plano não encontrado. Volte para a tela de planos e tente novamente.";
                return;
            }

            Logger.LogInformation("Cadastro: iniciando cadastro. PlanoId={PlanoId}, Email={Email}", PlanoId.Value, cadastroModel.Email);

            var resultado = await UsuarioCadastroService.CadastrarUsuarioAsync(cadastroModel, PlanoId.Value);

            Logger.LogInformation("Cadastro: usuário salvo. UsuarioId={UsuarioId}", resultado.UsuarioId);

            if (!string.IsNullOrWhiteSpace(resultado.CheckoutUrl))
            {
                Navigation.NavigateTo(resultado.CheckoutUrl, forceLoad: true);
                return;
            }

            sucesso = "Conta criada com sucesso. Não foi possível iniciar o checkout automaticamente.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro real ao concluir cadastro.");
            erro = Environment.IsDevelopment()
                ? $"Erro ao concluir cadastro: {ex.Message}"
                : "Não foi possível concluir o cadastro. Verifique os dados e tente novamente.";
        }
        finally
        {
            isSaving = false;
        }
    }
}
