@page "/objetivos"
@rendermode InteractiveServer
@using FinanceiroPessoal.Core.Models
@using FinanceiroPessoal.Core.Services
@inject ObjetivoFinanceiroService ObjetivoFinanceiroService
@inject IUsuarioAtualService UsuarioAtualService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Objetivos financeiros</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6 objetivos-page">
    <MudStack Spacing="1" Class="mb-4">
        <MudText Typo="Typo.h4" Class="page-title">Objetivos financeiros</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">Crie metas, acompanhe o progresso e saiba quanto falta para realizar seus planos.</MudText>
    </MudStack>

    <MudGrid Class="mb-4">
        <MudItem xs="12" md="4">
            <MudPaper Class="summary-card summary-blue pa-4">
                <MudText Typo="Typo.caption">Objetivos ativos</MudText>
                <MudText Typo="Typo.h5">@objetivos.Count</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="summary-card summary-green pa-4">
                <MudText Typo="Typo.caption">Total guardado</MudText>
                <MudText Typo="Typo.h5">@TotalAtual.ToString("C")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="summary-card summary-orange pa-4">
                <MudText Typo="Typo.caption">Total faltante</MudText>
                <MudText Typo="Typo.h5">@TotalFaltante.ToString("C")</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4 mb-5 form-card">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudText Typo="Typo.h6">@(form.Id == 0 ? "Novo objetivo" : "Editar objetivo")</MudText>
            @if (form.Id != 0)
            {
                <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="CancelarEdicao">Cancelar edição</MudButton>
            }
        </MudStack>

        <MudGrid>
            <MudItem xs="12" md="4">
                <MudTextField Label="Nome" @bind-Value="form.Nome" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudNumericField T="decimal" Label="Valor alvo" @bind-Value="form.ValorAlvo" Variant="Variant.Outlined" Min="0.01m" Required="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudNumericField T="decimal" Label="Valor atual" @bind-Value="form.ValorAtual" Variant="Variant.Outlined" Min="0" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudDatePicker Label="Data meta" @bind-Date="dataMeta" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="string" Label="Cor" @bind-Value="form.Cor" Variant="Variant.Outlined">
                    @foreach (var cor in cores)
                    {
                        <MudSelectItem T="string" Value="@cor.Valor">@cor.Nome</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="string" Label="Ícone" @bind-Value="form.Icone" Variant="Variant.Outlined">
                    @foreach (var icone in icones)
                    {
                        <MudSelectItem T="string" Value="@icone.Valor">@icone.Nome</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SalvarAsync">@(form.Id == 0 ? "Criar objetivo" : "Salvar alterações")</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (!objetivos.Any())
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Nenhum objetivo financeiro cadastrado ainda. Crie seu primeiro objetivo para acompanhar o progresso.</MudAlert>
    }
    else
    {
        <MudGrid>
            @foreach (var objetivo in objetivos)
            {
                <MudItem xs="12" md="6" lg="4">
                    <MudPaper Class="objective-card pa-4">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <span class="objective-icon" style="background:@objetivo.Cor">@ObterEmoji(objetivo.Icone)</span>
                                <div>
                                    <MudText Typo="Typo.h6">@objetivo.Nome</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Prazo: @FormatarPrazo(objetivo)</MudText>
                                </div>
                            </MudStack>
                        </MudStack>

                        <MudProgressLinear Value="@((double)objetivo.Percentual)" Min="0" Max="100" Color="Color.Primary" Rounded="true" Class="mb-2" />
                        <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-3">
                            <MudText Typo="Typo.body2"><strong>@objetivo.Percentual.ToString("N1")%</strong></MudText>
                            <MudText Typo="Typo.body2">@objetivo.ValorAtual.ToString("C") / @objetivo.ValorAlvo.ToString("C")</MudText>
                        </MudStack>

                        <MudDivider Class="my-3" />

                        <MudGrid>
                            <MudItem xs="6">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Falta</MudText>
                                <MudText Typo="Typo.subtitle2">@objetivo.ValorFaltante.ToString("C")</MudText>
                            </MudItem>
                            <MudItem xs="6">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Meta</MudText>
                                <MudText Typo="Typo.subtitle2">@(objetivo.DataMeta?.ToString("dd/MM/yyyy") ?? "Sem data")</MudText>
                            </MudItem>
                        </MudGrid>

                        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1" Class="mt-4">
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => Editar(objetivo))">Editar</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => InativarAsync(objetivo.Id))">Inativar</MudButton>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

<style>
.objetivos-page { background: #f7faff; border-radius: 20px; }
.page-title { color: #0d2f64; font-weight: 800; }
.form-card, .objective-card, .summary-card { border-radius: 18px; box-shadow: 0 8px 24px rgba(10,34,80,.08); background: #fff; }
.summary-card { border-left: 5px solid #2563eb; }
.summary-blue { border-left-color: #2563eb; }
.summary-green { border-left-color: #16a34a; }
.summary-orange { border-left-color: #f97316; }
.objective-card { height: 100%; border-top: 4px solid #2563eb; }
.objective-icon { align-items: center; border-radius: 16px; color: #fff; display: inline-flex; font-size: 24px; height: 48px; justify-content: center; min-width: 48px; }
</style>

@code {
    private readonly List<(string Nome, string Valor)> cores =
    [
        ("Azul", "#2563eb"),
        ("Verde", "#16a34a"),
        ("Roxo", "#7c3aed"),
        ("Laranja", "#f97316"),
        ("Rosa", "#db2777")
    ];

    private readonly List<(string Nome, string Valor)> icones =
    [
        ("Economia", "savings"),
        ("Casa", "home"),
        ("Carro", "car"),
        ("Viagem", "travel"),
        ("Educação", "school"),
        ("Emergência", "shield")
    ];

    private List<ObjetivoFinanceiro> objetivos = new();
    private ObjetivoFinanceiro form = NovoObjetivo();
    private DateTime? dataMeta = DateTime.Today.AddMonths(6);
    private int usuarioId;

    private decimal TotalAtual => objetivos.Sum(x => x.ValorAtual);
    private decimal TotalFaltante => objetivos.Sum(x => x.ValorFaltante);

    protected override async Task OnInitializedAsync()
    {
        var uid = await UsuarioAtualService.ObterUsuarioIdAsync();
        if (!uid.HasValue)
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        usuarioId = uid.Value;
        await CarregarAsync();
    }

    private async Task CarregarAsync() => objetivos = await ObjetivoFinanceiroService.ListarAsync(usuarioId);

    private async Task SalvarAsync()
    {
        try
        {
            form.DataMeta = dataMeta;
            if (form.Id == 0)
                await ObjetivoFinanceiroService.CriarAsync(usuarioId, form);
            else
                await ObjetivoFinanceiroService.AtualizarAsync(usuarioId, form);

            Snackbar.Add("Objetivo financeiro salvo com sucesso.", Severity.Success);
            await CarregarAsync();
            LimparFormulario();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void Editar(ObjetivoFinanceiro objetivo)
    {
        form = new ObjetivoFinanceiro
        {
            Id = objetivo.Id,
            UsuarioId = objetivo.UsuarioId,
            Nome = objetivo.Nome,
            ValorAlvo = objetivo.ValorAlvo,
            ValorAtual = objetivo.ValorAtual,
            DataMeta = objetivo.DataMeta,
            Cor = objetivo.Cor,
            Icone = objetivo.Icone,
            Ativo = objetivo.Ativo,
            DataCriacao = objetivo.DataCriacao,
            DataAtualizacao = objetivo.DataAtualizacao
        };
        dataMeta = objetivo.DataMeta;
    }

    private async Task InativarAsync(int id)
    {
        await ObjetivoFinanceiroService.InativarAsync(usuarioId, id);
        Snackbar.Add("Objetivo financeiro inativado.", Severity.Info);
        await CarregarAsync();

        if (form.Id == id)
            LimparFormulario();
    }

    private void CancelarEdicao() => LimparFormulario();

    private void LimparFormulario()
    {
        form = NovoObjetivo();
        dataMeta = DateTime.Today.AddMonths(6);
    }

    private static ObjetivoFinanceiro NovoObjetivo() => new()
    {
        Cor = "#2563eb",
        Icone = "savings",
        DataMeta = DateTime.Today.AddMonths(6)
    };

    private static string FormatarPrazo(ObjetivoFinanceiro objetivo)
    {
        if (!objetivo.DiasRestantes.HasValue)
            return "sem data";

        if (objetivo.DiasRestantes.Value < 0)
            return $"vencido há {Math.Abs(objetivo.DiasRestantes.Value)} dia(s)";

        if (objetivo.DiasRestantes.Value == 0)
            return "hoje";

        return $"faltam {objetivo.DiasRestantes.Value} dia(s)";
    }

    private static string ObterEmoji(string icone) => icone switch
    {
        "home" => "🏠",
        "car" => "🚗",
        "travel" => "✈️",
        "school" => "🎓",
        "shield" => "🛡️",
        _ => "💰"
    };
}
