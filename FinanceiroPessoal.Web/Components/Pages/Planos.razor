@page "/planos"
@rendermode InteractiveServer
@using FinanceiroPessoal.Core.Data
@using FinanceiroPessoal.Core.Models
@using Microsoft.EntityFrameworkCore
@inject FinanceiroDbContext Db
@inject NavigationManager Navigation
@inject ILogger<Planos> Logger

<PageTitle>Planos GranaOK</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="planos-page py-8">
    <MudStack Spacing="1" Class="text-center mb-6">
        <MudText Typo="Typo.h4" Class="planos-title">Planos para organizar sua vida financeira</MudText>
        <MudText Typo="Typo.body1" Class="planos-subtitle">Escolha o plano ideal para acompanhar receitas, despesas, contas, categorias e sua evolução financeira.</MudText>
        <div><MudChip Color="Color.Success" Variant="Variant.Filled">14 dias grátis em qualquer plano</MudChip></div>
    </MudStack>

    <div class="billing-toggle mb-6">
        <MudButton Variant="@(anual ? Variant.Outlined : Variant.Filled)" Color="Color.Primary" OnClick="() => anual = false">Mensal</MudButton>
        <MudButton Variant="@(anual ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="() => anual = true">Anual</MudButton>
    </div>

    @if (!string.IsNullOrWhiteSpace(erro))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@erro</MudAlert>
    }

    <MudGrid>
        @foreach (var card in cards)
        {
            var preco = anual ? card.PrecoAnual : card.PrecoMensal;
            var periodo = anual ? "/ ano" : "/ mês";
            var planoId = anual ? card.PlanoAnualId : card.PlanoMensalId;

            <MudItem xs="12" md="6">
                <MudPaper Class="plan-card @(card.IsPlus ? "plus" : "mensal")">
                    <MudChip Class="mb-3" Color="@(card.IsPlus ? Color.Success : Color.Primary)" Variant="Variant.Filled">@card.Badge</MudChip>
                    <MudText Typo="Typo.h5">@card.Titulo</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">@card.Descricao</MudText>
                    <MudText Typo="Typo.h4" Class="price">@($"R$ {preco:N2}") <span>@periodo</span></MudText>
                    @if (anual && !string.IsNullOrWhiteSpace(card.EconomiaAnual))
                    {
                        <MudText Typo="Typo.caption" Class="economia">@card.EconomiaAnual</MudText>
                    }

                    <ul class="feature-list">
                        @foreach (var feature in card.Recursos)
                        {
                            <li><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="feature-ok" /> @feature</li>
                        }
                    </ul>

                    <MudButton FullWidth="true" Variant="Variant.Filled" Color="@(card.IsPlus ? Color.Success : Color.Primary)" OnClick="() => Assinar(planoId, anual)">@card.Botao</MudButton>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <MudPaper Class="comparison mt-8 pa-4">
        <MudText Typo="Typo.h6" Class="mb-3">Comparativo de recursos</MudText>
        <table class="comparison-table">
            <thead><tr><th>Recursos</th><th>Mensal</th><th>Plus</th></tr></thead>
            <tbody>
                @foreach (var item in comparativo)
                {
                    <tr>
                        <td>@item.Nome</td>
                        <td>@RenderBool(item.Mensal)</td>
                        <td>@RenderBool(item.Plus)</td>
                    </tr>
                }
            </tbody>
        </table>
    </MudPaper>
</MudContainer>

@code {
    private readonly List<CardPlano> cards =
    [
        new(false, "GranaOK Mensal", "Mais escolhido", "Ideal para controle financeiro pessoal", 19.90m, 199.00m, "Economize R$ 39,80 por ano", "Assinar plano", new() { "Dashboard financeiro", "Lançamentos ilimitados", "Categorias, pessoas e contas", "Relatórios essenciais", "Assistente financeiro com IA", "14 dias grátis" }),
        new(true, "GranaOK Plus", "Plano avançado", "Para quem quer ir além do controle básico", 29.90m, 299.00m, "Economize R$ 59,80 por ano", "Assinar Plus", new() { "Tudo do plano Mensal", "Carteira de investimentos", "Cadastro manual de ativos", "Rentabilidade e preço médio", "Relatórios avançados", "14 dias grátis" })
    ];

    private readonly List<(string Nome, bool Mensal, bool Plus)> comparativo =
    [
        ("Dashboard financeiro", true, true),
        ("Lançamentos ilimitados", true, true),
        ("Categorias, pessoas e contas", true, true),
        ("Assistente financeiro com IA", true, true),
        ("Carteira de investimentos", false, true),
        ("Cadastro manual de ativos", false, true),
        ("Rentabilidade e preço médio", false, true),
        ("Relatórios avançados", false, true)
    ];

    private bool anual;
    private string? erro;

    protected override async Task OnInitializedAsync()
    {
        var planos = await Db.Planos.AsNoTracking().Where(x => x.Ativo).ToListAsync();
        MapearPlanoIds(planos);
    }

    private void MapearPlanoIds(List<Plano> planos)
    {
        foreach (var card in cards)
        {
            card.PlanoMensalId = EncontrarPlanoId(planos, card.IsPlus, "month");
            card.PlanoAnualId = EncontrarPlanoId(planos, card.IsPlus, "year");
        }
    }

    private static int? EncontrarPlanoId(IEnumerable<Plano> planos, bool plus, string intervalo)
    {
        return planos.FirstOrDefault(p => p.Intervalo.Equals(intervalo, StringComparison.OrdinalIgnoreCase)
            && (plus ? p.Nome.Contains("plus", StringComparison.OrdinalIgnoreCase) : !p.Nome.Contains("plus", StringComparison.OrdinalIgnoreCase)))?.Id;
    }

    private void Assinar(int? planoId, bool anualSelecionado)
    {
        erro = null;
        if (!planoId.HasValue)
        {
            erro = anualSelecionado ? "Plano anual em breve." : "Plano indisponível no momento.";
            Logger.LogWarning("Plano indisponível para assinatura. Anual={Anual}", anualSelecionado);
            return;
        }

        Navigation.NavigateTo($"/usuarios/cadastro?planoId={planoId.Value}");
    }

    private RenderFragment RenderBool(bool enabled) => b =>
    {
        var icon = enabled ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Close;
        var cls = enabled ? "comp-ok" : "comp-no";
        b.OpenElement(0, "span");
        b.AddAttribute(1, "class", cls);
        b.OpenComponent<MudIcon>(2);
        b.AddAttribute(3, "Icon", icon);
        b.CloseComponent();
        b.CloseElement();
    };

    private sealed class CardPlano(bool isPlus, string titulo, string badge, string descricao, decimal precoMensal, decimal precoAnual, string economiaAnual, string botao, List<string> recursos)
    {
        public bool IsPlus { get; } = isPlus;
        public string Titulo { get; } = titulo;
        public string Badge { get; } = badge;
        public string Descricao { get; } = descricao;
        public decimal PrecoMensal { get; } = precoMensal;
        public decimal PrecoAnual { get; } = precoAnual;
        public string EconomiaAnual { get; } = economiaAnual;
        public string Botao { get; } = botao;
        public List<string> Recursos { get; } = recursos;
        public int? PlanoMensalId { get; set; }
        public int? PlanoAnualId { get; set; }
    }
}

<style>
.planos-page { background: #f6f9ff; border-radius: 20px; }
.planos-title { color: #0d2f64; font-weight: 700; }
.planos-subtitle { color: #3d5170; }
.billing-toggle { display: flex; gap: 12px; justify-content: center; }
.plan-card { background: white; border-radius: 20px; padding: 24px; box-shadow: 0 10px 30px rgba(10,34,80,.08); height: 100%; }
.plan-card.mensal { border-top: 5px solid #2176ff; }
.plan-card.plus { border-top: 5px solid #1fa971; }
.price span { font-size: .9rem; color: #60708a; }
.economia { color: #1fa971; font-weight: 600; }
.feature-list { list-style: none; padding: 0; margin: 16px 0 24px 0; }
.feature-list li { margin: 8px 0; color: #2d3c55; }
.feature-ok { color: #1fa971; margin-right: 6px; }
.comparison { border-radius: 20px; background: #fff; box-shadow: 0 8px 24px rgba(10,34,80,.08); }
.comparison-table { width: 100%; border-collapse: collapse; }
.comparison-table th, .comparison-table td { padding: 10px; border-bottom: 1px solid #eef2f8; }
.comp-ok { color: #1fa971; }
.comp-no { color: #98a2b3; }
</style>
